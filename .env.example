# Supabase (somente no servidor — nunca expor SUPABASE_SECRET_KEY no navegador)
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SECRET_KEY="MY_SUPABASE_SECRET_KEY"

# Token Bearer compartilhado entre o servidor do site e o n8n / bot
BOT_API_TOKEN="MY_BOT_API_TOKEN"

# URL pública do aplicativo (ex: https://holdpremios.vercel.app)
APP_URL="MY_APP_URL"
