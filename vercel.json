{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/api/bot/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/bot/admin/pending",
      "destination": "/api/bot/admin?resource=pending"
    },
    {
      "source": "/api/bot/admin/receipts/:ref/:action",
      "destination": "/api/bot/admin?resource=receipts&ref=:ref&action=:action"
    },
    {
      "source": "/api/bot/admin/orders/:ref/:action",
      "destination": "/api/bot/admin?resource=orders&ref=:ref&action=:action"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
